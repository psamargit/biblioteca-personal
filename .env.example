# Configuración de Flask
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Clave secreta de Flask (cambiar en producción)
SECRET_KEY=tu-clave-secreta-muy-segura-cambiar-en-produccion

# Base de datos
DATABASE_URL=sqlite:///instance/biblioteca.db

# Google Books API (opcional pero recomendado)
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# Configuración de uploads
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=app/static/uploads/covers

# Configuración de sesión
PERMANENT_SESSION_LIFETIME=604800

# En producción, configurar estas variables:
# FLASK_ENV=production
# FLASK_DEBUG=False
# SECRET_KEY=<generar-clave-segura-aleatoria>
# DATABASE_URL=sqlite:///path/to/production/database.db
